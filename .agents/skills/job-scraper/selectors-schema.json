{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "jobTitle": {
      "type": "string",
      "description": "Le titre de l'offre (ex: Développeur Fullstack TypeScript)"
    },
    "companyName": {
      "type": "string",
      "description": "Nom de l'entreprise qui recrute"
    },
    "location": {
      "type": "string",
      "description": "Ville ou code postal"
    },
    "contractType": {
      "type": "string",
      "enum": ["Apprentissage", "Professionnalisation", "Inconnu"]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "rawDescription": {
      "type": "string",
      "description": "Texte brut de l'annonce, nettoyé du HTML, prêt pour l'analyse IA."
    }
  },
  "required": ["jobTitle", "companyName", "url", "rawDescription"]
}
